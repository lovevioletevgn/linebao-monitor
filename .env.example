# 把这个文件复制成 .env（去掉 .example），然后填入真实值。
# .env 已被 .gitignore 排除，不会进仓库，也不会随项目传出去。

# ── PushPlus（微信推送，最省事）──
# 微信扫码登录 https://www.pushplus.plus/ 就能拿到 token
PUSHPLUS_TOKEN=

# ── 飞书群机器人（必填）──
# 飞书群 → 设置 → 群机器人 → 添加「自定义机器人」→ 复制 Webhook 地址
LINEBAO_FEISHU_WEBHOOK=
# 只有机器人开启了「签名校验」才需要填，否则留空
LINEBAO_FEISHU_SECRET=

# ── 企业微信（可选）──
LINEBAO_WECOM_WEBHOOK=
